        "notas = [7.5, 8.0, 6.5, 9.0, 5.5]\n",
        "\n",
        "#mostre:\n",
        "\n",
        "# a maior nota\n",
        "# a menor nota\n",
        "# a média das notas\n"
      ],
      "metadata": {
        "id": "9kckubpnlY9a"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "notas = [7.5, 8.0, 6.5, 9.0, 5.5]"
      ],
      "metadata": {
        "id": "PDLPmJu_nh7x"
      },
      "execution_count": 24,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "maior = max(notas)\n",
        "menor = min(notas)\n",
        "media = sum(notas) / len(notas)\n",
        "\n",
        "print(\"Maior nota:\", maior)\n",
        "print(\"Menor nota:\", menor)\n",
        "print(\"Média:\", media)\n"
      ],
      "metadata": {
        "colab": {
