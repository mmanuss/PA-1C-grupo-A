    },
    {
      "cell_type": "code",
      "source": [
        "# crie uma lista vazia chamada frutas\n",
        "frutas = []\n",
        "\n",
        "# utilizando append(), adicione 5 frutas informadas pelo usuário\n",
        "for i in range(5):\n",
        "    fruta_informada = input(f\"Digite o nome da {i+1}ª fruta: \")\n",
        "    frutas.append(fruta_informada)\n",
        "\n",
        "# ao final exiba a lista completa\n",
        "print(\"\\nLista completa de frutas:\")\n",
        "print(frutas)\n"
      ],
      "metadata": {
        "id": "7w584AB9ra-0"
      },
      "execution_count": null,
      "outputs": []
    },
