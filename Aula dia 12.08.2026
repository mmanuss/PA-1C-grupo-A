      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import builtins\n",
        "builtins.print(\"numeros pares: 2, 4, 6, 8, 10\")\n",
        "builtins.print(\"numeros impares: 1, 3, 5, 7, 9\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "JGyDGqcKxT5N",
        "outputId": "f4f448aa-0360-4867-f9ee-47a9b9714f0c"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
