    {
      "cell_type": "code",
      "source": [
        "#EXERCÍCIO 2\n",
        "\n",
        "# crie uma lista vazia chama frutas\n",
        "# utilizando append(), adicione 5 frutas informadas pelo usuário\n",
        "# ao final exiba a lista completa"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "UtmpdmmxqFNU",
        "outputId": "4e4b5867-6bbb-4d1e-ee28-04176db7009e"
