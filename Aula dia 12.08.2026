      "cell_type": "code",
      "source": [
        "#EXERCÍCIO 2\n",
        "\n",
        "# crie uma lista vazia chama frutas\n",
        "# utilizando append(), adicione 5 frutas informadas pelo usuário\n",
        "# ao final exiba a lista completa"
      ],
      "metadata": {
        "id": "1NeavELVjZf6"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import builtins\n",
        "\n",
        "lista_frutas = []\n",
        "for i in range (5):\n",
        "   frutas = input(f\" digite 1 fruta \")\n",
        "   lista_frutas.append(frutas)\n",
        "\n",
        "builtins.print(lista_frutas)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "UtmpdmmxqFNU",
        "outputId": "c257529a-0337-4ee5-8b0f-7cf3eb1bc77c"
      },
      "execution_count": 39,
