            "numeros impares: 1, 3, 5, 7, 9\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Cria uma lista com 10 números inteiros\n",
        "numeros = [10, 3, 5, 8, 12, 17, 22, 14, 9, 4]\n",
        "\n",
        "# Percorre cada número da lista\n",
        "for num in numeros:\n",
        "  # Se o resto da divisão por 2 for 0, é par\n",
        "  if num % 2 == 0:\n",
        "    print(f\"O número {num} é par.\")\n",
        "  else:\n",
        "    # Se não for 0, é ímpar\n",
        "    print(f\"O número {num} é ímpar.\")\n"
      ],
      "metadata": {
        "id": "s2qZYbrasYWF"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#Lista: Armazena os 10 valores inteiros na variável numeros.\n",
        "#Laço for: Passa por cada elemento da lista um por um.Condição if/else:num % 2 == 0 verifica se o número é divisível por 2.\n",
        "#Caso seja verdadeiro, exibe que é par. Caso contrário, exibe que é ímpar."
      ],
      "metadata": {
        "id": "teomwnFosZpk"
      },
      "execution_count": null,
      "outputs": []
    },
