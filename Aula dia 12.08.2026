        "#EXERCÍCIO 8\n",
        "\n",
        "#considere\n",
        "\n",
        "alunos = [\"ana\", \"carlos\", \"maria\", \"pedro\", \"joão\"]\n",
        "\n",
        "# peça ao usuáriopara digitar o nome, o programa devera verificar se o nome consta na lista ou não\n",
        "# faça o programa funcionar independente da forma como o usuário digitar, ex.: Maria, maria ou MARIA"
      ],
      "metadata": {
        "id": "Wpgl218Fmsoy"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "alunos = [\"ana\", \"carlos\", \"maria\", \"pedro\", \"joão\"]\n",
        "\n",
        "nome_usuario = input(\"Digite o nome do aluno: \").strip().lower()\n",
        "\n",
        "if nome_usuario in alunos:\n",
        "  print(\"O nome consta na lista.\")\n",
        "else:\n",
        "  print(\"O nome não consta na lista.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "9WxQOVWGpQS-",
        "outputId": "c7675d8d-4e66-4e0d-d0c8-08fd8f8b5bbf"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Digite o nome do aluno: Maria\n",
            "O nome consta na lista.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#input(): Pede para o usuário digitar um texto.\n",
        "#strip(): Remove espaços vazios antes ou depois do que o usuário digitou.\n",
        "#lower(): Transforma todas as letras em minúsculas para comparar com a lista.\n",
        "#in: Verifica se o valor digitado existe dentro da lista alunos."
      ],
      "metadata": {
        "id": "vWpllCZcpckW"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#EXERCÍCIO 9\n",
        "\n",
        "# crie uma lista vazia chamada números\n",
        "# peça ao usuário para informar 10 números\n",
        "# depois crie duas listas vazias chamadas pares e impares"
      ],
      "metadata": {
        "id": "NS3uR9jgnwPM"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "numeros = []\n",
        "\n",
        "for i in range(10):\n",
        "    n = int(input(f\"Digite o {i+1}º número: \"))\n",
        "    numeros.append(n)\n",
        "\n",
        "pares = []\n",
        "impares = []\n",
        "for n in numeros:\n",
        "    if n % 2 == 0:\n",
        "        pares.append(n)\n",
        "    else:\n",
        "        impares.append(n)\n",
        "\n",
        "print(\"Números:\", numeros)\n",
        "print(\"Pares:\", pares)\n",
        "print(\"Ímpares:\", impares)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "oPJ4L3q_p3pW",
        "outputId": "938e600a-07a2-4ed7-a7b9-6c5a2e91361b"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Digite o 1º número: 8\n",
            "Digite o 2º número: 1\n",
            "Digite o 3º número: 2\n",
            "Digite o 4º número: 3\n",
            "Digite o 5º número: 4\n",
            "Digite o 6º número: 5\n",
            "Digite o 7º número: 6\n",
            "Digite o 8º número: 7\n",
            "Digite o 9º número: 9\n",
            "Digite o 10º número: 10\n",
            "Números: [8, 1, 2, 3, 4, 5, 6, 7, 9, 10]\n",
            "Pares: [8, 2, 4, 6, 10]\n",
            "Ímpares: [1, 3, 5, 7, 9]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#EXERCÍCIO 10\n",
        "#faça um pequeno sistema para cadastrar as notas de 5 alunos\n",
        "\n",
        "#o programa deverá armazenar as notas em uma lista e depois mostrar:\n",
        "#todas as notas\n",
        "#a maior nota\n",
        "#a média da turma\n",
        "#a quantidade de alunos com nota maior ou igual a 6\n",
        "#quantidade de alunos com a nota maior que 6"
      ],
      "metadata": {
        "id": "T1RMB-fIibF1"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "notas = []\n",
        "\n",
        "# Cadastrar as notas de 5 alunos\n",
        "for i in range(5):\n",
        "    nota = float(input(f\"Digite a nota do aluno {i + 1}: \"))\n",
        "    notas.append(nota)\n",
        "\n",
        "# Calcular os dados\n",
        "maior_nota = max(notas)\n",
        "media_turma = sum(notas) / len(notas)\n",
        "\n",
        "# Contar alunos com nota >= 6 e > 6\n",
        "maior_igual_6 = sum(1 for n in notas if n >= 6)\n",
        "maior_que_6 = sum(1 for n in notas if n > 6)\n",
        "\n",
        "# Mostrar os resultados\n",
        "print(\"\\n--- Resultados ---\")\n",
        "print(f\"Todas as notas: {notas}\")\n",
        "print(f\"Maior nota: {maior_nota}\")\n",
        "print(f\"Média da turma: {media_turma:.2f}\")\n",
        "print(f\"Alunos com nota maior ou igual a 6: {maior_igual_6}\")\n",
        "print(f\"Alunos com nota maior que 6: {maior_que_6}\")\n"
      ],
      "metadata": {
